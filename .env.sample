# scdlbot configuration: environment variables. Only TG_BOT_TOKEN is required.
# Locally: copy to .env-dev and run `mise run dev`. With systemd: /etc/default/scdlbot.

### Telegram
# Bot token from https://t.me/BotFather
TG_BOT_TOKEN="166849652:AAEPCgHuDf3K6HvI2OkrJmDN2k9Rexample"
# Bot API server. A local one (https://github.com/tdlib/telegram-bot-api) allows 2000 MB files and
# reads files straight from disk; local mode is turned on automatically for 127.0.0.1/localhost.
#TG_BOT_API="https://api.telegram.org"
#TG_BOT_API="http://127.0.0.1:8081"
#TG_BOT_API_LOCAL_MODE="1"
# Your user id: gets /stats, can change /settings in any chat, receives error alerts
#TG_BOT_OWNER_CHAT_ID="1265343"

### Storage
# SQLite database with chat settings, the download queue and stats
#DB_PATH="scdlbot.sqlite3"
# Temporary download directory (one subdirectory per job, cleaned automatically)
#DL_DIR="/tmp/scdlbot"
# Delete per-download rows older than this many days (daily totals are kept forever); 0 keeps everything
#JOBS_RETENTION_DAYS="90"

### Downloads
# Parallel downloads
#WORKERS="4"
# Seconds to wait for each downloaded file, and for a whole job (e.g. an album)
#DL_TIMEOUT="300"
#JOB_TIMEOUT="1800"
# Telegram upload limit in bytes: 45 MB for the official Bot API (limit is 50 MB), 1900 MB with a local one.
# Bigger files are split into parts.
#MAX_TG_FILE_SIZE="45_000_000"
# Don't download files bigger than this (bytes)
#MAX_CONVERT_FILE_SIZE="350_000_000"
# Send at most this many items from a playlist/album/set
#MAX_PLAYLIST_ITEMS="50"
# Waiting jobs before new requests get "I'm overloaded", and queued+running jobs per user
#MAX_QUEUE="500"
#MAX_USER_JOBS="5"
# Threads for each ffmpeg run
#FFMPEG_THREADS="1"
# Extra yt-dlp arguments for every download, e.g. use node instead of deno for YouTube
#YTDLP_ARGS="--js-runtimes node"
# Cookies for sites that need a login: a local cookies.txt, a URL to download it from,
# or firefox:PROFILE[:URL_OF_COOKIES_SQLITE]. URLs are re-downloaded every COOKIES_REFRESH seconds.
#COOKIES_FILE="/etc/scdlbot/cookies.txt"
#COOKIES_REFRESH="600"
# Comma-separated proxies, one is picked at random per download; an empty item or "direct" means no proxy
#PROXIES=",http://127.0.0.1:3187,http://127.0.0.1:3188"
# Comma-separated source IPs, one is picked at random per download (0.0.0.0 forces IPv4)
#SOURCE_IPS="0.0.0.0"

### Chats and sites
# Chats where captions (and replies) are off by default
#NO_FLOOD_CHAT_IDS="-10018859218,-1011068201"
# Only these chats may use the bot / these chats may not. The bot leaves chats that aren't allowed.
#WHITELIST_CHATS="-1795100,1795102"
#BLACKLIST_CHATS="-1795100,1795102"
# Only download from these domains / never from these (exact host names, e.g. m.soundcloud.com)
#WHITELIST_DOMAINS="soundcloud.com,m.soundcloud.com"
#BLACKLIST_DOMAINS="invidious.tube,piped.kavin.rocks"

### Webhook (default is long polling)
#WEBHOOK_ENABLE="1"
# Where the bot listens
#HOST="127.0.0.1"
#PORT="5000"
# Public URL root and path; the webhook URL is ROOT/PATH. The path defaults to the token without ":".
#WEBHOOK_APP_URL_ROOT="https://bot.example.com"
#WEBHOOK_APP_URL_PATH="166849652AAEPCgHuDf3K6HvI2OkrJmDN2k9Rexample"
#WEBHOOK_SECRET_TOKEN="CHANGEME"
#WEBHOOK_CERT_FILE=""
#WEBHOOK_KEY_FILE=""
# Skip updates sent while the bot was down
#DROP_PENDING_UPDATES="1"

### Monitoring
# Prometheus metrics on http://METRICS_HOST:METRICS_PORT/metrics (port 0 disables)
#METRICS_HOST="127.0.0.1"
#METRICS_PORT="8000"
#LOGLEVEL="INFO"
# Sentry or GlitchTip DSN for error reports
#SENTRY_DSN="https://key@glitchtip.example.com/1"
